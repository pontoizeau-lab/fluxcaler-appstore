{
  "schemaVersion": 2,
  "services": [
    {
      "name": "fluxcaler-qdrant",
      "image": "qdrant/qdrant:latest",
      "internalPort": 6333,
      "isMain": true,
      "environment": [
        {
          "key": "QDRANT__SERVICE__API_KEY",
          "value": "${QDRANT_API_KEY}"
        },
        {
          "key": "QDRANT__SERVICE__GRPC_PORT",
          "value": "6334"
        },
        {
          "key": "QDRANT__SERVICE__ENABLE_TLS",
          "value": "false"
        },
        {
          "key": "QDRANT__LOG_LEVEL",
          "value": "INFO"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/storage",
          "containerPath": "/qdrant/storage"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/snapshots",
          "containerPath": "/qdrant/snapshots"
        }
      ],
      "healthCheck": {
        "test": "bash -c 'exec 3<>/dev/tcp/127.0.0.1/6333 && printf \"GET /readyz HTTP/1.0\\r\\nHost: localhost\\r\\n\\r\\n\" >&3 && head -1 <&3 | grep -q \" 200\"'",
        "interval": "30s",
        "timeout": "10s",
        "retries": 3
      },
      "addPorts": [
        {
          "containerPort": 6333,
          "hostPort": 6335,
          "protocol": "tcp"
        },
        {
          "containerPort": 6334,
          "hostPort": 6336,
          "protocol": "tcp"
        }
      ]
    }
  ]
}
