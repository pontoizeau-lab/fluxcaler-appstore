{
  "schemaVersion": 2,
  "services": [
    {
      "name": "fluxcaler-max",
      "image": "registry.fluxcaler.net/fluxcaler/max:1.0.3",
      "internalPort": 4096,
      "isMain": true,
      "environment": [
        { "key": "AIPROXY_TOKEN", "value": "${AIPROXY_TOKEN}" },
        { "key": "OPENCODE_SERVER_PASSWORD", "value": "${OPENCODE_SERVER_PASSWORD}" }
      ],
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/config", "containerPath": "/root/.config/opencode" },
        { "hostPath": "${APP_DATA_DIR}/data", "containerPath": "/root/.local/share/opencode" },
        { "hostPath": "${APP_DATA_DIR}/workspace", "containerPath": "/workspace" }
      ],
      "healthCheck": {
        "test": "curl -so /dev/null http://localhost:4096/ || exit 1",
        "interval": "30s",
        "timeout": "10s",
        "retries": 3
      },
      "addPorts": [
        { "containerPort": 4096, "hostPort": 4310, "protocol": "tcp" }
      ]
    }
  ]
}
