{
  "schemaVersion": 2,
  "services": [
    {
      "name": "fluxcaler-gitlab",
      "image": "gitlab/gitlab-ce:latest",
      "internalPort": 80,
      "isMain": true,
      "environment": [
        { "key": "GITLAB_ROOT_PASSWORD", "value": "${GITLAB_ROOT_PASSWORD}" },
        { "key": "GITLAB_OMNIBUS_CONFIG", "value": "external_url '${GITLAB_EXTERNAL_URL}'; nginx['listen_port'] = 80; nginx['listen_https'] = false; letsencrypt['enable'] = false; gitlab_rails['gitlab_shell_ssh_port'] = 2222; gitlab_rails['initial_root_password'] = '${GITLAB_ROOT_PASSWORD}'; prometheus_monitoring['enable'] = false; sidekiq['concurrency'] = 5; puma['worker_processes'] = 2;" }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/config",
          "containerPath": "/etc/gitlab"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/logs",
          "containerPath": "/var/log/gitlab"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/gitlab",
          "containerPath": "/var/opt/gitlab"
        }
      ],
      "healthCheck": {
        "test": "curl -f http://localhost:80/-/health || exit 1",
        "interval": "60s",
        "timeout": "15s",
        "retries": 10
      },
      "addPorts": [
        { "containerPort": 80, "hostPort": 8929, "protocol": "tcp" },
        { "containerPort": 22, "hostPort": 2222, "protocol": "tcp" }
      ]
    }
  ]
}
