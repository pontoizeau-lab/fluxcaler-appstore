{
  "schemaVersion": 2,
  "services": [
    {
      "name": "fluxcaler-supabase-db",
      "image": "supabase/postgres:latest",
      "internalPort": 5432,
      "isMain": false,
      "environment": [
        {
          "key": "POSTGRES_HOST",
          "value": "/var/run/postgresql"
        },
        {
          "key": "PGPORT",
          "value": "5432"
        },
        {
          "key": "POSTGRES_PORT",
          "value": "5432"
        },
        {
          "key": "PGPASSWORD",
          "value": "${POSTGRES_PASSWORD}"
        },
        {
          "key": "POSTGRES_PASSWORD",
          "value": "${POSTGRES_PASSWORD}"
        },
        {
          "key": "PGDATABASE",
          "value": "postgres"
        },
        {
          "key": "POSTGRES_DB",
          "value": "postgres"
        },
        {
          "key": "JWT_SECRET",
          "value": "${JWT_SECRET}"
        },
        {
          "key": "JWT_EXP",
          "value": "3600"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/postgres",
          "containerPath": "/var/lib/postgresql/data"
        }
      ],
      "healthCheck": {
        "test": "pg_isready -U postgres -h localhost",
        "interval": "10s",
        "timeout": "5s",
        "retries": 5
      },
      "addPorts": [
        {
          "containerPort": 5432,
          "hostPort": 5433,
          "protocol": "tcp"
        }
      ]
    },
    {
      "name": "fluxcaler-supabase-kong",
      "image": "kong:latest",
      "internalPort": 8000,
      "isMain": true,
      "dependsOn": [
        "fluxcaler-supabase-auth",
        "fluxcaler-supabase-rest",
        "fluxcaler-supabase-realtime",
        "fluxcaler-supabase-storage",
        "fluxcaler-supabase-meta"
      ],
      "environment": [
        {
          "key": "KONG_DATABASE",
          "value": "off"
        },
        {
          "key": "KONG_DECLARATIVE_CONFIG",
          "value": "/var/lib/kong/kong.yml"
        },
        {
          "key": "KONG_DNS_ORDER",
          "value": "LAST,A,CNAME"
        },
        {
          "key": "KONG_PLUGINS",
          "value": "request-transformer,cors,key-auth,acl,basic-auth"
        },
        {
          "key": "KONG_NGINX_PROXY_PROXY_BUFFER_SIZE",
          "value": "160k"
        },
        {
          "key": "KONG_NGINX_PROXY_PROXY_BUFFERS",
          "value": "64 160k"
        },
        {
          "key": "SUPABASE_ANON_KEY",
          "value": "${ANON_KEY}"
        },
        {
          "key": "SUPABASE_SERVICE_KEY",
          "value": "${SERVICE_ROLE_KEY}"
        },
        {
          "key": "DASHBOARD_USERNAME",
          "value": "${DASHBOARD_USERNAME}"
        },
        {
          "key": "DASHBOARD_PASSWORD",
          "value": "${DASHBOARD_PASSWORD}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/config/kong.yml",
          "containerPath": "/var/lib/kong/kong.yml",
          "readOnly": true
        }
      ],
      "addPorts": [
        {
          "containerPort": 8000,
          "hostPort": 8010,
          "protocol": "tcp"
        },
        {
          "containerPort": 8443,
          "hostPort": 8444,
          "protocol": "tcp"
        }
      ]
    },
    {
      "name": "fluxcaler-supabase-auth",
      "image": "supabase/gotrue:latest",
      "internalPort": 9999,
      "isMain": false,
      "dependsOn": [
        "fluxcaler-supabase-db"
      ],
      "environment": [
        {
          "key": "GOTRUE_API_HOST",
          "value": "0.0.0.0"
        },
        {
          "key": "GOTRUE_API_PORT",
          "value": "9999"
        },
        {
          "key": "API_EXTERNAL_URL",
          "value": "${SITE_URL}"
        },
        {
          "key": "GOTRUE_DB_DRIVER",
          "value": "postgres"
        },
        {
          "key": "GOTRUE_DB_DATABASE_URL",
          "value": "postgres://supabase_auth_admin:${POSTGRES_PASSWORD}@fluxcaler-supabase-db:5432/postgres"
        },
        {
          "key": "GOTRUE_SITE_URL",
          "value": "${SITE_URL}"
        },
        {
          "key": "GOTRUE_URI_ALLOW_LIST",
          "value": "*"
        },
        {
          "key": "GOTRUE_DISABLE_SIGNUP",
          "value": "false"
        },
        {
          "key": "GOTRUE_JWT_ADMIN_ROLES",
          "value": "service_role"
        },
        {
          "key": "GOTRUE_JWT_AUD",
          "value": "authenticated"
        },
        {
          "key": "GOTRUE_JWT_DEFAULT_GROUP_NAME",
          "value": "authenticated"
        },
        {
          "key": "GOTRUE_JWT_EXP",
          "value": "3600"
        },
        {
          "key": "GOTRUE_JWT_SECRET",
          "value": "${JWT_SECRET}"
        },
        {
          "key": "GOTRUE_EXTERNAL_EMAIL_ENABLED",
          "value": "${ENABLE_EMAIL_SIGNUP}"
        },
        {
          "key": "GOTRUE_MAILER_AUTOCONFIRM",
          "value": "${ENABLE_EMAIL_AUTOCONFIRM}"
        },
        {
          "key": "GOTRUE_SMTP_HOST",
          "value": "${SMTP_HOST}"
        },
        {
          "key": "GOTRUE_SMTP_PORT",
          "value": "${SMTP_PORT}"
        },
        {
          "key": "GOTRUE_SMTP_USER",
          "value": "${SMTP_USER}"
        },
        {
          "key": "GOTRUE_SMTP_PASS",
          "value": "${SMTP_PASS}"
        },
        {
          "key": "GOTRUE_SMTP_ADMIN_EMAIL",
          "value": "${SMTP_SENDER_EMAIL}"
        },
        {
          "key": "GOTRUE_MAILER_URLPATHS_INVITE",
          "value": "/auth/v1/verify"
        },
        {
          "key": "GOTRUE_MAILER_URLPATHS_CONFIRMATION",
          "value": "/auth/v1/verify"
        },
        {
          "key": "GOTRUE_MAILER_URLPATHS_RECOVERY",
          "value": "/auth/v1/verify"
        },
        {
          "key": "GOTRUE_MAILER_URLPATHS_EMAIL_CHANGE",
          "value": "/auth/v1/verify"
        }
      ],
      "healthCheck": {
        "test": "wget --no-verbose --tries=1 --spider http://localhost:9999/health || exit 1",
        "interval": "10s",
        "timeout": "5s",
        "retries": 3
      }
    },
    {
      "name": "fluxcaler-supabase-rest",
      "image": "postgrest/postgrest:latest",
      "internalPort": 3000,
      "isMain": false,
      "dependsOn": [
        "fluxcaler-supabase-db"
      ],
      "environment": [
        {
          "key": "PGRST_DB_URI",
          "value": "postgres://authenticator:${POSTGRES_PASSWORD}@fluxcaler-supabase-db:5432/postgres"
        },
        {
          "key": "PGRST_DB_SCHEMAS",
          "value": "public,storage,graphql_public"
        },
        {
          "key": "PGRST_DB_ANON_ROLE",
          "value": "anon"
        },
        {
          "key": "PGRST_JWT_SECRET",
          "value": "${JWT_SECRET}"
        },
        {
          "key": "PGRST_DB_USE_LEGACY_GUCS",
          "value": "false"
        },
        {
          "key": "PGRST_APP_SETTINGS_JWT_SECRET",
          "value": "${JWT_SECRET}"
        },
        {
          "key": "PGRST_APP_SETTINGS_JWT_EXP",
          "value": "3600"
        }
      ],
      "healthCheck": {
        "test": "wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1",
        "interval": "10s",
        "timeout": "5s",
        "retries": 3
      }
    },
    {
      "name": "fluxcaler-supabase-realtime",
      "image": "supabase/realtime:latest",
      "internalPort": 4000,
      "isMain": false,
      "dependsOn": [
        "fluxcaler-supabase-db"
      ],
      "environment": [
        {
          "key": "PORT",
          "value": "4000"
        },
        {
          "key": "DB_HOST",
          "value": "fluxcaler-supabase-db"
        },
        {
          "key": "DB_PORT",
          "value": "5432"
        },
        {
          "key": "DB_USER",
          "value": "supabase_admin"
        },
        {
          "key": "DB_PASSWORD",
          "value": "${POSTGRES_PASSWORD}"
        },
        {
          "key": "DB_NAME",
          "value": "postgres"
        },
        {
          "key": "DB_AFTER_CONNECT_QUERY",
          "value": "SET search_path TO _realtime"
        },
        {
          "key": "DB_ENC_KEY",
          "value": "supabaserealtime"
        },
        {
          "key": "API_JWT_SECRET",
          "value": "${JWT_SECRET}"
        },
        {
          "key": "FLY_ALLOC_ID",
          "value": "fly123"
        },
        {
          "key": "FLY_APP_NAME",
          "value": "realtime"
        },
        {
          "key": "SECRET_KEY_BASE",
          "value": "${JWT_SECRET}"
        },
        {
          "key": "ERL_AFLAGS",
          "value": "-proto_dist inet_tcp"
        },
        {
          "key": "ENABLE_TAILSCALE",
          "value": "false"
        },
        {
          "key": "DNS_NODES",
          "value": "''"
        }
      ],
      "healthCheck": {
        "test": "wget --no-verbose --tries=1 --spider http://localhost:4000/api/health || exit 1",
        "interval": "10s",
        "timeout": "5s",
        "retries": 3
      }
    },
    {
      "name": "fluxcaler-supabase-storage",
      "image": "supabase/storage-api:latest",
      "internalPort": 5000,
      "isMain": false,
      "dependsOn": [
        "fluxcaler-supabase-db",
        "fluxcaler-supabase-imgproxy"
      ],
      "environment": [
        {
          "key": "ANON_KEY",
          "value": "${ANON_KEY}"
        },
        {
          "key": "SERVICE_KEY",
          "value": "${SERVICE_ROLE_KEY}"
        },
        {
          "key": "POSTGREST_URL",
          "value": "http://fluxcaler-supabase-rest:3000"
        },
        {
          "key": "PGRST_JWT_SECRET",
          "value": "${JWT_SECRET}"
        },
        {
          "key": "DATABASE_URL",
          "value": "postgres://supabase_storage_admin:${POSTGRES_PASSWORD}@fluxcaler-supabase-db:5432/postgres"
        },
        {
          "key": "FILE_SIZE_LIMIT",
          "value": "52428800"
        },
        {
          "key": "STORAGE_BACKEND",
          "value": "file"
        },
        {
          "key": "FILE_STORAGE_BACKEND_PATH",
          "value": "/var/lib/storage"
        },
        {
          "key": "TENANT_ID",
          "value": "stub"
        },
        {
          "key": "REGION",
          "value": "stub"
        },
        {
          "key": "GLOBAL_S3_BUCKET",
          "value": "stub"
        },
        {
          "key": "ENABLE_IMAGE_TRANSFORMATION",
          "value": "true"
        },
        {
          "key": "IMGPROXY_URL",
          "value": "http://fluxcaler-supabase-imgproxy:5001"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/storage",
          "containerPath": "/var/lib/storage"
        }
      ],
      "healthCheck": {
        "test": "wget --no-verbose --tries=1 --spider http://localhost:5000/status || exit 1",
        "interval": "10s",
        "timeout": "5s",
        "retries": 3
      }
    },
    {
      "name": "fluxcaler-supabase-imgproxy",
      "image": "darthsim/imgproxy:latest",
      "internalPort": 5001,
      "isMain": false,
      "environment": [
        {
          "key": "IMGPROXY_BIND",
          "value": ":5001"
        },
        {
          "key": "IMGPROXY_LOCAL_FILESYSTEM_ROOT",
          "value": "/"
        },
        {
          "key": "IMGPROXY_USE_ETAG",
          "value": "true"
        },
        {
          "key": "IMGPROXY_ENABLE_WEBP_DETECTION",
          "value": "true"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/storage",
          "containerPath": "/var/lib/storage",
          "readOnly": true
        }
      ],
      "healthCheck": {
        "test": "imgproxy health",
        "interval": "10s",
        "timeout": "5s",
        "retries": 3
      }
    },
    {
      "name": "fluxcaler-supabase-meta",
      "image": "supabase/postgres-meta:latest",
      "internalPort": 8080,
      "isMain": false,
      "dependsOn": [
        "fluxcaler-supabase-db"
      ],
      "environment": [
        {
          "key": "PG_META_PORT",
          "value": "8080"
        },
        {
          "key": "PG_META_DB_HOST",
          "value": "fluxcaler-supabase-db"
        },
        {
          "key": "PG_META_DB_PORT",
          "value": "5432"
        },
        {
          "key": "PG_META_DB_NAME",
          "value": "postgres"
        },
        {
          "key": "PG_META_DB_USER",
          "value": "supabase_admin"
        },
        {
          "key": "PG_META_DB_PASSWORD",
          "value": "${POSTGRES_PASSWORD}"
        }
      ],
      "healthCheck": {
        "test": "wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1",
        "interval": "10s",
        "timeout": "5s",
        "retries": 3
      }
    },
    {
      "name": "fluxcaler-supabase-studio",
      "image": "supabase/studio:latest",
      "internalPort": 3000,
      "isMain": false,
      "dependsOn": [
        "fluxcaler-supabase-kong"
      ],
      "environment": [
        {
          "key": "STUDIO_PG_META_URL",
          "value": "http://fluxcaler-supabase-meta:8080"
        },
        {
          "key": "POSTGRES_PASSWORD",
          "value": "${POSTGRES_PASSWORD}"
        },
        {
          "key": "DEFAULT_ORGANIZATION_NAME",
          "value": "Fluxcaler"
        },
        {
          "key": "DEFAULT_PROJECT_NAME",
          "value": "Default Project"
        },
        {
          "key": "SUPABASE_URL",
          "value": "http://fluxcaler-supabase-kong:8000"
        },
        {
          "key": "SUPABASE_PUBLIC_URL",
          "value": "${SITE_URL}"
        },
        {
          "key": "SUPABASE_ANON_KEY",
          "value": "${ANON_KEY}"
        },
        {
          "key": "SUPABASE_SERVICE_KEY",
          "value": "${SERVICE_ROLE_KEY}"
        },
        {
          "key": "LOGFLARE_API_KEY",
          "value": ""
        },
        {
          "key": "LOGFLARE_URL",
          "value": ""
        },
        {
          "key": "NEXT_PUBLIC_ENABLE_LOGS",
          "value": "false"
        },
        {
          "key": "NEXT_ANALYTICS_BACKEND_PROVIDER",
          "value": "postgres"
        }
      ],
      "addPorts": [
        {
          "containerPort": 3000,
          "hostPort": 3002,
          "protocol": "tcp"
        }
      ]
    }
  ]
}
