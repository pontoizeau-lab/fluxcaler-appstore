{
  "schemaVersion": 2,
  "services": [
    {
      "name": "fluxcaler-n8n-staging",
      "image": "n8nio/n8n:latest",
      "internalPort": 5678,
      "isMain": true,
      "environment": [
        {
          "key": "N8N_PORT",
          "value": "5678"
        },
        {
          "key": "N8N_PROTOCOL",
          "value": "http"
        },
        {
          "key": "WEBHOOK_URL",
          "value": "http://localhost:5681/"
        },
        {
          "key": "N8N_DIAGNOSTICS_ENABLED",
          "value": "false"
        },
        {
          "key": "GENERIC_TIMEZONE",
          "value": "${TZ}"
        },
        {
          "key": "TZ",
          "value": "${TZ}"
        },
        {
          "key": "N8N_SECURE_COOKIE",
          "value": "false"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/n8n_staging",
          "containerPath": "/home/node/.n8n"
        }
      ],
      "healthCheck": {
        "test": "wget --no-verbose --tries=1 --spider http://localhost:5678/healthz || exit 1",
        "interval": "30s",
        "timeout": "10s",
        "retries": 3
      },
      "addPorts": [
        {
          "containerPort": 5678,
          "hostPort": 5681,
          "protocol": "tcp"
        }
      ]
    }
  ]
}
